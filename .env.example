# Required: any OpenAI-compatible chat endpoint
NUGGET_API_BASE=
NUGGET_CHAT_MODEL=
NUGGET_API_KEY=

# Required: any OpenAI-compatible EMBEDDINGS endpoint — a separate provider from the one
# above, since most chat providers don't offer one (this one deliberately doesn't run an
# embedding model in-process: that alone measured 600MB+ of RAM, more than most free hosting
# tiers). Free-tier options with an OpenAI-compatible /v1/embeddings route as of writing:
# NVIDIA NIM (model: nvidia/nemotron-3-embed-1b), Mistral AI (model: mistral-embed),
# Jina AI, Voyage AI. On NVIDIA the model id needs its `nvidia/` prefix, and asymmetric
# models (e.g. llama-nemotron-embed-vl-1b-v2) are rejected — they demand an input_type
# param that OpenAI-compatible clients don't send.
NUGGET_EMBEDDING_API_BASE=
NUGGET_EMBEDDING_MODEL=
NUGGET_EMBEDDING_API_KEY=

# Optional
NUGGET_CHROMA_DIR=./data/chroma
NUGGET_CORS_ORIGINS=http://localhost:3000
